{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/zellerfeld/",
      "destination": "/zellerfeld",
      "permanent": false
    },
    {
      "source": "/profile{/}?",
      "destination": "/about/",
      "statusCode": 301
    },
    {
      "source": "/profile/:path*",
      "destination": "/about/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "svenahrens.com"
        }
      ],
      "destination": "https://sven.fm/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.svenahrens.com"
        }
      ],
      "destination": "https://sven.fm/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "book.svenahrens.com"
        }
      ],
      "destination": "https://calendar.app.google/HZiaHw4n3Lj1MniaA",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cal.svenahrens.com"
        }
      ],
      "destination": "https://calendar.app.google/HZiaHw4n3Lj1MniaA",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "30min.svenahrens.com"
        }
      ],
      "destination": "https://calendar.app.google/3tksiiYJRLdBNiV59",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "60min.svenahrens.com"
        }
      ],
      "destination": "https://calendar.app.google/t91wtpEGvW6QDBhK7",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/zellerfeld",
      "destination": "https://zellerfeld-six.vercel.app/zellerfeld"
    },
    {
      "source": "/zellerfeld/:path*",
      "destination": "https://zellerfeld-six.vercel.app/zellerfeld/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/og-c3.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
